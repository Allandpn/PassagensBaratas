# Copie para .env e preencha (uso local). No GitHub, use Settings > Secrets and variables > Actions.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789
# Opcional: push no celular via ntfy (app ntfy, inscrito no mesmo topico).
# NTFY_TOPIC=meu-topico-secreto
# Servidor proprio, se nao usar o publico ntfy.sh
# NTFY_SERVER=https://ntfy.sh
# Opcional: proxy residencial, caso o Google bloqueie o IP do runner do GitHub
# PROXY_URL=http://usuario:senha@host:porta
